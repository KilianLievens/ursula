[Unit]
Description=Ursula Eink Service
After=dev-input-by_bt_kbd.device
BindsTo=dev-input-by_bt_kbd.device

[Service]
Type=simple
User=root
WorkingDirectory=/home/kilian/ursula
Environment="PYTHONPATH=/home/kilian/ursula"
ExecStart=/home/kilian/ursula/.venv/bin/python /home/kilian/ursula/ursula/main.py eink
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
